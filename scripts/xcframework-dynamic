#!/bin/bash

# Exit immediately if a command exits with a non-zero status
set -e

# Fail if any command in a pipeline fails
set -o pipefail

# Function to display usage information
show_usage() {
    echo
    echo "This script builds a dynamic XCFramework for a <TARGET> and certain <PLATFORMS>."

    echo
    echo "Usage: $0 [TARGET] [-p|--platforms <PLATFORM1> <PLATFORM2> ...] [--no-dsyms] [--no-zip]"
    echo "  [TARGET]              Optional. The target to build framework for (defaults to package name)"
    echo "  -p, --platforms       Optional. List of platforms (default: iOS macOS macCatalyst tvOS watchOS xrOS)"
    echo "      --no-dsyms        Optional. Skip generating the dSYMs zip (dSYMs are generated by default)"
    echo "      --no-zip          Optional. Skip generating the XCFramework zip (a zip is generated by default)"
    echo "  -h, --help            Show this help message"

    echo
    echo "This script only works for packages that define the products as .dynamic."
    echo "It builds the Swift package directly, so no .xcodeproj is needed."

    echo
    echo "Named platforms build both device and simulator slices. Add a -device"
    echo "suffix to build a device-only slice, or a -simulator suffix to build a"
    echo "simulator-only one. macOS and macCatalyst have no simulator variants."
    echo "Platform names are case-insensitive, so iOS and ios are both accepted."

    echo
    echo "The XCFramework ends up in .build/artifacts and, unless --no-zip is"
    echo "passed, a zip file is placed in .build. Unless --no-dsyms is passed,"
    echo "debug symbols are zipped into .build as well."

    echo
    echo "Examples:"
    echo "  $0"
    echo "  $0 MyTarget"
    echo "  $0 -p iOS macOS"
    echo "  $0 MyTarget -p iOS macOS"
    echo "  $0 MyTarget --platforms iOS macOS tvOS watchOS xrOS"
    echo "  $0 MyTarget -p iOS-device"
    echo "  $0 MyTarget --no-dsyms --no-zip"
    echo
}

# Function to display error message, show usage, and exit
show_error_and_exit() {
    echo
    local error_message="$1"
    echo "Error: $error_message"
    show_usage
    exit 1
}

# Define argument variables
TARGET=""
PLATFORMS="iOS macOS macCatalyst tvOS watchOS xrOS"  # Default platforms
GENERATE_DSYMS=1  # Default to generating dSYMs
GENERATE_ZIPS=1   # Default to generating zip files

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -p|--platforms)
            shift  # Remove --platforms from arguments
            PLATFORMS=""  # Clear default platforms
            
            # Collect all platform arguments until we hit another flag or run out of args
            while [[ $# -gt 0 && ! "$1" =~ ^- ]]; do
                PLATFORMS="$PLATFORMS $1"
                shift
            done
            
            # Remove leading space and check if we got any platforms
            PLATFORMS=$(echo "$PLATFORMS" | sed 's/^ *//')
            if [ -z "$PLATFORMS" ]; then
                show_error_and_exit "--platforms requires at least one platform"
            fi
            ;;
        --dsyms)
            GENERATE_DSYMS=1; shift ;;
        --no-dsyms)
            GENERATE_DSYMS=0; shift ;;
        --zip)
            GENERATE_ZIPS=1; shift ;;
        --no-zip)
            GENERATE_ZIPS=0; shift ;;
        -h|--help)
            show_usage; exit 0 ;;
        -*)
            show_error_and_exit "Unknown option $1" ;;
        *)
            if [ -z "$TARGET" ]; then
                TARGET="$1"
            else
                show_error_and_exit "Unexpected argument '$1'"
            fi
            shift
            ;;
    esac
done

# If no TARGET was provided, try to get package name
if [ -z "$TARGET" ]; then
    FOLDER="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
    SCRIPT_PACKAGE_NAME="$FOLDER/package-name"

    if [ ! -f "$SCRIPT_PACKAGE_NAME" ]; then
        show_error_and_exit "Script not found: $SCRIPT_PACKAGE_NAME"
    fi

    if ! TARGET=$("$SCRIPT_PACKAGE_NAME"); then
        show_error_and_exit "Failed to get package name"
    fi
fi

# Define local variables
BUILD_FOLDER=.build
BUILD_FOLDER_ARTIFACTS=$BUILD_FOLDER/artifacts
BUILD_FOLDER_ARCHIVES=$BUILD_FOLDER/framework_archives
BUILD_FILE=$BUILD_FOLDER_ARTIFACTS/$TARGET.xcframework
BUILD_ZIP=$BUILD_FOLDER/$TARGET.zip
DSYM_FOLDER=$BUILD_FOLDER_ARCHIVES/dSYMs
DSYM_ZIP=$BUILD_FOLDER/$TARGET-dSYMs.zip

# All platforms that this script can build, as "name|destination"
# pairs, where the name doubles as the archive file name
ALL_PLATFORMS=(
    "iOS|generic/platform=iOS"
    "iOS-simulator|generic/platform=iOS Simulator"
    "macOS|generic/platform=macOS"
    "macCatalyst|generic/platform=macOS,variant=Mac Catalyst"
    "tvOS|generic/platform=tvOS"
    "tvOS-simulator|generic/platform=tvOS Simulator"
    "watchOS|generic/platform=watchOS"
    "watchOS-simulator|generic/platform=watchOS Simulator"
    "xrOS|generic/platform=visionOS"
    "xrOS-simulator|generic/platform=visionOS Simulator"
)

# A function that lowercases a platform name, so that the names
# above can be matched however the caller happened to type them
fold_platform() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

# A function that stages the named platform, ignoring any name
# that is already staged, so that a repeated argument can't add
# the same slice twice. Matching ignores case, while the staged
# entry keeps the canonical spelling for paths and output.
SLICES=()
add_platform() {
    local WANT
    WANT=$(fold_platform "$1")

    local STAGED
    for STAGED in ${SLICES[@]+"${SLICES[@]}"}; do
        [ "$(fold_platform "${STAGED%%|*}")" = "$WANT" ] && return 0
    done

    local ENTRY
    for ENTRY in "${ALL_PLATFORMS[@]}"; do
        if [ "$(fold_platform "${ENTRY%%|*}")" = "$WANT" ]; then
            SLICES+=("$ENTRY")
            return 0
        fi
    done

    return 1
}

# Resolve the requested platforms into slices to build. A bare
# name also pulls in that platform's simulator, since a framework
# without simulator slices can't be used in Xcode previews or on
# simulator destinations. Use a -device suffix to opt out, or a
# -simulator suffix to only build that slice.
for PLATFORM in $PLATFORMS; do
    case "$(fold_platform "$PLATFORM")" in
        *-device)
            add_platform "${PLATFORM%-[dD][eE][vV][iI][cC][eE]}" || true
            ;;
        *)
            add_platform "$PLATFORM" || true
            add_platform "$PLATFORM-simulator" || true
            ;;
    esac
done

if [ ${#SLICES[@]} -eq 0 ]; then
    show_error_and_exit "No platform matched [$PLATFORMS]. Known platforms: $(printf '%s ' "${ALL_PLATFORMS[@]%%|*}")"
fi

# Start script
echo
echo "Building $TARGET XCFramework for [$(printf '%s ' "${SLICES[@]%%|*}")]..."

# Delete old builds
echo "Cleaning old builds..."
rm -rf $BUILD_ZIP
rm -rf $BUILD_FILE
rm -rf $BUILD_FOLDER_ARCHIVES
rm -rf $DSYM_ZIP
mkdir -p $BUILD_FOLDER_ARCHIVES
mkdir -p $DSYM_FOLDER

# Generate XCArchive files for all platforms
echo "Generating XCArchives..."

# Initialize the xcframework command arguments
XCFRAMEWORK_ARGS=()

for ENTRY in "${SLICES[@]}"; do
    NAME="${ENTRY%%|*}"
    DESTINATION="${ENTRY#*|}"
    ARCHIVE="$BUILD_FOLDER_ARCHIVES/$TARGET-$NAME.xcarchive"
    DERIVED_DATA="$BUILD_FOLDER_ARCHIVES/derived-data-$NAME"

    # Build the archive for this platform. Note that using the
    # BUILD_LIBRARY_FOR_DISTRIBUTION flag builds a .swiftinterface,
    # so that the framework keeps working across compiler versions.
    echo "Building $NAME archive from $TARGET..."
    if ! xcodebuild archive -scheme $TARGET -configuration Release -destination "$DESTINATION" -archivePath "$ARCHIVE" -derivedDataPath "$DERIVED_DATA" SKIP_INSTALL=NO BUILD_LIBRARY_FOR_DISTRIBUTION=YES DEBUG_INFORMATION_FORMAT=dwarf-with-dsym; then
        show_error_and_exit "Failed to build $NAME archive"
    fi

    # Find the build products folder, where macOS uses a plain
    # "Release" folder and other platforms a "Release-<sdk>" one
    PRODUCTS=$(find "$DERIVED_DATA/Build/Intermediates.noindex/ArchiveIntermediates/$TARGET/BuildProductsPath" -maxdepth 1 -type d -name "Release*" | head -1)

    # Find the dynamic framework that SwiftPM built for the platform
    FRAMEWORK=$(find "$ARCHIVE/Products" -name "$TARGET.framework" -type d | head -1)
    if [ -z "$FRAMEWORK" ]; then
        show_error_and_exit "No framework for $NAME in $ARCHIVE"
    fi

    # Work on a copy, since the swiftmodule must be added to it.
    # Copy without -L, since macOS frameworks are versioned bundles
    # held together by symlinks (Versions/Current -> A, and the root
    # entries pointing into it). Dereferencing those turns them into
    # real directories, which makes the bundle malformed and fails
    # linking with "Couldn't resolve framework symlink for .../Current".
    STAGED_FRAMEWORK="$BUILD_FOLDER_ARCHIVES/framework-$NAME/$TARGET.framework"
    mkdir -p "$(dirname "$STAGED_FRAMEWORK")"
    rm -rf "$STAGED_FRAMEWORK"
    cp -R "$FRAMEWORK" "$STAGED_FRAMEWORK"

    # SwiftPM leaves the .swiftmodule beside the framework instead
    # of within it, so move it in. Consumers can't import the module
    # without this.
    SWIFTMODULE="$PRODUCTS/$TARGET.swiftmodule"
    if [ ! -d "$SWIFTMODULE" ]; then
        show_error_and_exit "No swiftmodule for $NAME at $SWIFTMODULE"
    fi

    # macOS frameworks are versioned and keep their modules within
    # Versions/A/Modules, while other platforms keep them at root.
    # A versioned bundle also needs a root Modules symlink into the
    # current version, since that's where consumers look for it.
    if [ -d "$STAGED_FRAMEWORK/Versions/A" ]; then
        mkdir -p "$STAGED_FRAMEWORK/Versions/A/Modules"
        cp -RL "$SWIFTMODULE" "$STAGED_FRAMEWORK/Versions/A/Modules/"
        if [ ! -e "$STAGED_FRAMEWORK/Modules" ]; then
            ln -s "Versions/Current/Modules" "$STAGED_FRAMEWORK/Modules"
        fi
    else
        mkdir -p "$STAGED_FRAMEWORK/Modules"
        cp -RL "$SWIFTMODULE" "$STAGED_FRAMEWORK/Modules/"
    fi

    XCFRAMEWORK_ARGS+=(-framework "$STAGED_FRAMEWORK")

    # Ship debug symbols alongside the framework, so that crash
    # reports can be symbolicated. Note that the -debug-symbols
    # argument requires an absolute path.
    DSYM=$(find "$ARCHIVE/dSYMs" -name "$TARGET.framework.dSYM" -type d | head -1)
    if [ -n "$DSYM" ]; then
        XCFRAMEWORK_ARGS+=(-debug-symbols "$(cd "$DSYM" && pwd)")

        # Keep a per-slice copy for the dSYMs zip, where the slice
        # name is used to keep the copies from colliding
        cp -RL "$DSYM" "$DSYM_FOLDER/$NAME-$TARGET.framework.dSYM"
    fi
done

# Generate XCFramework
echo "Generating XCFramework..."
mkdir -p "$(dirname $BUILD_FILE)"
if ! xcodebuild -create-xcframework "${XCFRAMEWORK_ARGS[@]}" -output $BUILD_FILE; then
    show_error_and_exit "Failed to generate XCFramework"
fi

# Generate XCFramework zip and checksum, unless --no-zip was passed
if [ "$GENERATE_ZIPS" == "1" ]; then
    echo "Generating XCFramework zip..."

    # Using --keepParent roots the archive at the .xcframework
    # instead of embedding the full .build/artifacts path
    if ! ditto -c -k --keepParent $BUILD_FILE $BUILD_ZIP; then
        show_error_and_exit "Failed to generate XCFramework zip"
    fi

    echo
    echo "***** FRAMEWORK CHECKSUM *****"
    swift package compute-checksum $BUILD_ZIP
    echo "******************************"
fi

# Package dSYMs separately, unless --no-dsyms was passed
if [ "$GENERATE_DSYMS" == "1" ]; then
    if [ -d "$DSYM_FOLDER" ] && [ "$(ls -A $DSYM_FOLDER)" ]; then
        if [ "$GENERATE_ZIPS" == "1" ]; then
            echo "Generating dSYMs zip..."
            if ! ditto -c -k --keepParent $DSYM_FOLDER $DSYM_ZIP; then
                show_error_and_exit "Failed to generate dSYMs zip"
            fi
        else
            echo "dSYMs collected but not zipped (--no-zip was passed)"
        fi
    else
        echo "Warning: No dSYMs found to package"
    fi
fi

# Delete the intermediate build files
rm -rf $BUILD_FOLDER_ARCHIVES

# Complete successfully
echo
echo "$TARGET XCFramework created successfully!"
echo
